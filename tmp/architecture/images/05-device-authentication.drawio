        <mxCell id="c0" value="CONNECT: the key must belong to a device. Publish and subscribe: the device must be connected to the channel." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;fontColor=#424242;" parent="1" vertex="1"><mxGeometry x="840" y="70" width="240" height="55" as="geometry"/></mxCell>
