        <mxCell id="c4" value="The trap source is bound to a device; that device's key is checked per trap." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;fontColor=#424242;" parent="1" vertex="1"><mxGeometry x="840" y="355" width="240" height="50" as="geometry"/></mxCell>
