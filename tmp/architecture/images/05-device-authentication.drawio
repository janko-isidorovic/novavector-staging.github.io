        <mxCell id="c2" value="Key and channel checked when the socket opens." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;fontColor=#424242;" parent="1" vertex="1"><mxGeometry x="840" y="215" width="240" height="45" as="geometry"/></mxCell>
