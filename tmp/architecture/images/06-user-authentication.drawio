<mxfile host="nviot-docs">
  <diagram name="User authentication" id="user-auth">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1260" pageHeight="700" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="User authentication and access (nviot)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=14;fontStyle=1;fontColor=#212121;" parent="1" vertex="1"><mxGeometry x="10" y="0" width="600" height="24" as="geometry"/></mxCell>
        <mxCell id="browser" value="&lt;b&gt;Web browser&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;console (nviot-ui) with keycloak-js;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;menu and pages follow the&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;user's module roles&lt;/font&gt;" style="rounded=1;arcSize=8;fillColor=#F5F5F5;strokeColor=#616161;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="20" y="230" width="220" height="110" as="geometry"/></mxCell>
        <mxCell id="nginx" value="&lt;b&gt;nv-nginx :443&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;routes by path&lt;/font&gt;" style="rounded=1;arcSize=8;fillColor=#FCE4EC;strokeColor=#880E4F;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="340" y="230" width="180" height="110" as="geometry"/></mxCell>
        <mxCell id="kc" value="&lt;b&gt;Keycloak&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;reached through nv-nginx at /auth;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;realm NovaVector: users, groups,&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;realm and client roles;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;optional one-time code&lt;/font&gt;" style="rounded=1;arcSize=8;fillColor=#FCE4EC;strokeColor=#880E4F;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="620" y="50" width="260" height="100" as="geometry"/></mxCell>
        <mxCell id="svc" value="&lt;b&gt;Platform service&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;e.g. things, plans, tasks;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;every /v1 service checks&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;the token itself&lt;/font&gt;" style="rounded=1;arcSize=8;fillColor=#E1F5FE;strokeColor=#01579B;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="620" y="240" width="260" height="90" as="geometry"/></mxCell>
        <mxCell id="pg" value="&lt;b&gt;PostgreSQL&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;every record carries&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;owner = &amp;lt;realm&amp;gt;.&amp;lt;group&amp;gt;&lt;/font&gt;" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#E8F5E9;strokeColor=#2E7D32;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="980" y="230" width="220" height="110" as="geometry"/></mxCell>
        <mxCell id="o2p" value="&lt;b&gt;oauth2-proxy :4180&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;cookie session&lt;/font&gt;" style="rounded=1;arcSize=8;fillColor=#FCE4EC;strokeColor=#880E4F;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="330" y="440" width="150" height="60" as="geometry"/></mxCell>
        <mxCell id="cons" value="&lt;b&gt;Admin consoles&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;OpenSearch Dashboards, Prometheus,&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Jaeger, Node-RED, Nuclio, Swagger,&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Redis Commander, AI model API&lt;/font&gt;" style="rounded=1;arcSize=8;fillColor=#F3E5F5;strokeColor=#4A148C;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="620" y="420" width="260" height="80" as="geometry"/></mxCell>
        <mxCell id="graf" value="&lt;b&gt;Grafana&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;own Keycloak login; role from&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;its client roles&lt;/font&gt;" style="rounded=1;arcSize=8;fillColor=#E1F5FE;strokeColor=#01579B;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="620" y="540" width="260" height="60" as="geometry"/></mxCell>
        <mxCell id="sa" value="&lt;b&gt;Service accounts&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;production worker, provisioning,&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;deployment-manager:&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;client-credentials tokens&lt;/font&gt;" style="rounded=1;arcSize=8;fillColor=#FFF9C4;strokeColor=#F57F17;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="980" y="50" width="220" height="90" as="geometry"/></mxCell>
        <mxCell id="rule" value="&lt;b&gt;Rule in each service&lt;/b&gt;&lt;br&gt;1. Token active (introspection at Keycloak).&lt;br&gt;2. Permission: realm role &lt;i&gt;create&lt;/i&gt;, &lt;i&gt;update&lt;/i&gt; or &lt;i&gt;delete&lt;/i&gt; for writes (&lt;i&gt;admin&lt;/i&gt; passes).&lt;br&gt;3. Scope: only records whose owner is one of the user's groups." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;fontColor=#424242;" parent="1" vertex="1"><mxGeometry x="980" y="420" width="260" height="110" as="geometry"/></mxCell>
        <mxCell id="e1-browser-kc" value="1. log in (authorization code flow)&lt;br&gt;2. tokens: access 5 min + refresh;&lt;br&gt;roles and groups in the token" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=9;strokeColor=#880E4F;strokeWidth=2;fontColor=#880E4F;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;startArrow=block;startFill=1;exitX=0.5;exitY=0;entryX=0;entryY=0.5;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" parent="1" source="browser" target="kc" edge="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="130" y="100"/></Array></mxGeometry></mxCell>
        <mxCell id="e2-browser-nginx" value="3. /v1/… with&lt;br&gt;Bearer token" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=9;strokeColor=#880E4F;strokeWidth=2;fontColor=#880E4F;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;exitX=1;exitY=0.3;entryX=0;entryY=0.3;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" parent="1" source="browser" target="nginx" edge="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e3-nginx-svc" value="4. routed by path" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=9;strokeColor=#880E4F;strokeWidth=2;fontColor=#880E4F;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;exitX=1;exitY=0.3;entryX=0;entryY=0.3;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" parent="1" source="nginx" target="svc" edge="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e4-svc-kc" value="5. token introspection" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=9;strokeColor=#880E4F;strokeWidth=2;fontColor=#880E4F;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;dashed=1;exitX=0.5;exitY=0;entryX=0.5;entryY=1;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" parent="1" source="svc" target="kc" edge="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e5-svc-pg" value="6. query limited to&lt;br&gt;the user's groups" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=9;strokeColor=#2E7D32;strokeWidth=2;fontColor=#2E7D32;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" parent="1" source="svc" target="pg" edge="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e6-browser-nginx" value="admin console" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=9;strokeColor=#880E4F;strokeWidth=2;fontColor=#880E4F;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;exitX=1;exitY=0.8;entryX=0;entryY=0.8;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" parent="1" source="browser" target="nginx" edge="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e7-nginx-o2p" value="auth_request" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=9;strokeColor=#880E4F;strokeWidth=2;fontColor=#880E4F;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;exitX=0.361;exitY=1;entryX=0.5;entryY=0;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" parent="1" source="nginx" target="o2p" edge="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e8-o2p-kc" value="OIDC login" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=9;strokeColor=#880E4F;strokeWidth=2;fontColor=#880E4F;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;dashed=1;exitX=1;exitY=0.33;entryX=0;entryY=0.85;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" parent="1" source="o2p" target="kc" edge="1"><mxGeometry x="0.4" relative="1" as="geometry"><Array as="points"><mxPoint x="535" y="460"/><mxPoint x="535" y="135"/></Array></mxGeometry></mxCell>
        <mxCell id="e9-nginx-cons" value="when the session is valid" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=9;strokeColor=#880E4F;strokeWidth=2;fontColor=#880E4F;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;exitX=1;exitY=0.85;entryX=0;entryY=0.4;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" parent="1" source="nginx" target="cons" edge="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="560" y="324"/><mxPoint x="560" y="452"/></Array><mxPoint x="58" y="-6" as="offset"/></mxGeometry></mxCell>
        <mxCell id="e10-nginx-graf" value="/grafana" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=9;strokeColor=#880E4F;strokeWidth=2;fontColor=#880E4F;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;exitX=0.917;exitY=1;entryX=0;entryY=0.5;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" parent="1" source="nginx" target="graf" edge="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="505" y="570"/></Array></mxGeometry></mxCell>
        <mxCell id="e11-graf-kc" value="OIDC" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=9;strokeColor=#880E4F;strokeWidth=2;fontColor=#880E4F;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;dashed=1;exitX=1;exitY=0.5;entryX=0.85;entryY=1;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" parent="1" source="graf" target="kc" edge="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="920" y="570"/><mxPoint x="920" y="200"/><mxPoint x="841" y="200"/></Array></mxGeometry></mxCell>
